# TiDB Configuration.

# TiDB server host.
# Defaults to localhost only; set "0.0.0.0" to accept connections from other
# machines.
host = "127.0.0.1"

# tidb server advertise IP.
advertise-address = ""

# TiDB server port.
port = 4000

# Registered store name, [tikv, mocktikv]
store = "mocktikv"

# TiDB storage path. For mocktikv this is a directory, created with mode 0700;
# a relative path is resolved from the directory the server starts in.
path = "tinysql-data"

# Schema lease duration, very dangerous to change only if you know what you do.
lease = "45s"

# Maximum number of concurrent client connections, including ones still logging
# in. 0 means unlimited.
max-server-connections = 151

[log]
# Log level: debug, info, warn, error, fatal.
level = "info"

# Replace the literal values in SQL text written to the log with "?". Set to
# false (or start with -redact-sql=false) only when debugging locally.
redact-sql = true

# Log every statement clients send, with connection ID, user and schema.
general-log = false

# File logging.
[log.file]
# Log file name.
filename = ""

# Max log file size in MB (upper limit to 4096MB).
max-size = 300

# Days to keep rotated log files.
max-days = 7

# Number of rotated log files to keep.
max-backups = 10

[status]
# Start the status HTTP server. It has no authentication, so it is off by default.
report-status = false

# TiDB status host.
status-host = "127.0.0.1"

# TiDB status port. Must not be 0 when report-status is true.
status-port = 10080

# Serve Go pprof at http://${status-host}:${status-port}/debug/pprof. pprof
# exposes heap dumps and process arguments; enable it only for local debugging.
enable-pprof = false

[security]
# TLS for MySQL clients: set ssl-cert and ssl-key (PEM files) to enable it.
# ssl-ca optionally verifies client certificates.
ssl-ca = ""
ssl-cert = ""
ssl-key = ""
# The root password is not set here. It is read from the TINYSQL_ROOT_PASSWORD
# environment variable, or generated into <path>/root-password on first start.
